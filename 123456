cat > dlpai-chat-layer-test.sh <<'DLPAI_LAYER_END'
#!/bin/bash
# Chat layer check: (1) does the RUNNING Open WebUI process have the DB settings? (2) can the model call a tool at all?
#   sudo bash dlpai-chat-layer-test.sh        (model name from LLM_MODEL; gateway on 127.0.0.1:5560)
set -uo pipefail
M="$(grep -E '^LLM_MODEL=' /etc/dlpai/environment 2>/dev/null | tail -1 | cut -d= -f2-)"; M="${LLM_MODEL:-$M}"
echo "== 1. running Open WebUI process: DB settings present?"
PID="$(systemctl show -p MainPID --value dlpai-openwebui 2>/dev/null)"
if [ -r "/proc/${PID:-0}/environ" ]; then
  n="$(tr '\0' '\n' < /proc/$PID/environ | grep -c '^DB_SEARCH_\(MONGO_URL\|DATABASE\)=.\+')"
  [ "$n" = 2 ] && echo "  ✔️ DB_SEARCH_MONGO_URL and DB_SEARCH_DATABASE are loaded in the running process" \
               || echo "  ✗ only $n of 2 DB_SEARCH_* values in the running process: run 'sudo dlpai reconfigure' (restart is not enough)"
else echo "  ? cannot read the process environment (run with sudo; unit dlpai-openwebui main PID=${PID:-none})"; fi
echo "== 2. can the model call a tool? (model: ${M:-unknown}; may take a minute on CPU)"
LLM_M="$M" python3 - <<'PY'
import json, os, urllib.request, time
m = os.environ.get("LLM_M") or ""
body = {"model": m, "temperature": 0, "max_tokens": 1500, "tool_choice": "auto",
        "messages": [{"role": "user", "content": "How many clients are in the database? Use the tool."}],
        "tools": [{"type": "function", "function": {"name": "explore_data", "description": "Run a read-only query on the report database and return rows and counts.",
                   "parameters": {"type": "object", "properties": {"collection": {"type": "string"}}, "required": ["collection"]}}}]}
req = urllib.request.Request("http://127.0.0.1:5560/v1/chat/completions", json.dumps(body).encode(), {"Content-Type": "application/json"})
t = time.time()
try:
    r = json.load(urllib.request.urlopen(req, timeout=300))
except Exception as e:
    print("  ✗ request failed: %s %s" % (type(e).__name__, str(e)[:160])); raise SystemExit
msg = r["choices"][0]["message"]; calls = msg.get("tool_calls") or []
print("  answered in %.0f s, finish_reason=%s" % (time.time() - t, r["choices"][0].get("finish_reason")))
if calls: print("  ✔️ the model CALLS tools: %s(%s)" % (calls[0]["function"]["name"], calls[0]["function"]["arguments"][:80]))
else: print("  ✗ the model did NOT call the tool; it answered with text: %r" % (msg.get("content") or "")[:160])
PY
DLPAI_LAYER_END
sudo bash dlpai-chat-layer-test.sh
